{
  "name": "diginiger-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node scripts/seed-users.mjs && node scripts/seed.mjs",
    "seed:content": "node scripts/seed.mjs",
    "seed:users": "node scripts/seed-users.mjs",
    "migrate": "node scripts/apply-migrations.mjs",
    "check": "node scripts/e2e-check.mjs && node scripts/e2e-ui.mjs && node scripts/e2e-actions.mjs && node scripts/payment-sandbox.mjs",
    "check:db": "node scripts/e2e-check.mjs",
    "check:ui": "node scripts/e2e-ui.mjs",
    "check:actions": "node scripts/e2e-actions.mjs",
    "ai:check": "node scripts/ai-check.mjs",
    "ai:index": "node scripts/index-knowledge.mjs",
    "payments:sandbox": "node scripts/payment-sandbox.mjs",
    "check:payments": "node scripts/payment-sandbox.mjs",
    "doctor": "node scripts/env-doctor.mjs",
    "certs:models": "esbuild src/lib/certificates/pdf.ts --bundle --platform=node --format=esm --outfile=scripts/.tmp/cert-pdf.mjs --alias:server-only=./scripts/_empty.js --external:pdf-lib --external:qrcode && node scripts/generate-school-certificates.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.462.0",
    "next": "^15.0.3",
    "openai": "^4.73.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "ws": "^8.22.1"
  }
}
