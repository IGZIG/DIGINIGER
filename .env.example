# ---------------------------------------------------------------------------
# DIGINIGER — variables d'environnement
# Copier en .env.local et renseigner. Ne jamais committer .env.local.
# ---------------------------------------------------------------------------

# Supabase (exposé au navigateur — clé publishable uniquement)
NEXT_PUBLIC_SUPABASE_URL=https://dthflsyrhhbpoiecajun.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Serveur uniquement — ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=xxx

# Tuteur IA (OpenAI)
OPENAI_API_KEY=sk-xxx
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Paiements Mobile Money (agrégateur type PayDunya / CinetPay)
PAYMENT_PROVIDER_NAME=paydunya
PAYMENT_API_KEY=xxx
PAYMENT_API_SECRET=xxx
PAYMENT_WEBHOOK_SECRET=xxx
PAYMENT_MODE=test

# ---------------------------------------------------------------------------
# Connexion directe PostgreSQL (scripts de migration et de seed, jamais exposée
# au navigateur). Récupérable dans Supabase → Project Settings → Database.
# ---------------------------------------------------------------------------
SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=xxx
SUPABASE_DB_NAME=postgres

# ---------------------------------------------------------------------------
# Intelligence artificielle (tuteur RAG + générateur de formations)
# ---------------------------------------------------------------------------
# Fournisseur : openai (défaut) ou compatible (Azure OpenAI, OpenRouter, Groq,
# Mistral, vLLM, Ollama en mode OpenAI…). Aucune clé n'est exposée au client.
AI_PROVIDER=openai
# Endpoint alternatif (obligatoire si AI_PROVIDER=compatible)
# AI_BASE_URL=https://mon-endpoint/v1
OPENAI_API_KEY=sk-xxx
OPENAI_CHAT_MODEL=gpt-4o-mini
# text-embedding-3-small = 1536 dimensions = colonne vector(1536).
# text-embedding-3-large en 1536 est aussi accepté (paramètre dimensions).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Paiement Mobile Money — PayDunya (Airtel, Orange, Moov…)
# Tableau de bord : https://app.paydunya.com → Intégrations > Clés
# Webhook à déclarer : https://<domaine>/api/payments/webhook?provider=mobile_money
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=paydunya
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=xxx
PAYDUNYA_PRIVATE_KEY=xxx
PAYDUNYA_TOKEN=xxx
# Surcharges facultatives (tests locaux / proxy d'entreprise)
# PAYDUNYA_API_URL=https://app.paydunya.com/sandbox-api/v1
# PAYDUNYA_CHECKOUT_URL=https://paydunya.com/checkout/invoice

# ---------------------------------------------------------------------------
# Paiement — CinetPay (alternative Mobile Money + cartes)
# PAYMENT_PROVIDER=cinetpay pour l'activer.
# ---------------------------------------------------------------------------
CINETPAY_API_KEY=xxx
CINETPAY_SITE_ID=xxx
# Si définie, l'en-tête x-token des notifications est vérifié en HMAC-SHA256.
CINETPAY_SECRET_KEY=xxx

# ---------------------------------------------------------------------------
# Adaptateur générique / carte bancaire (signature HMAC maison)
# ---------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=xxx
# PAYMENT_API_URL=
# PAYMENT_API_KEY=
# PAYMENT_API_SECRET=
# CARD_API_URL=
# CARD_API_KEY=
# CARD_WEBHOOK_SECRET=
